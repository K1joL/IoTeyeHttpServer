@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CMake will replace @IOTEYE_USE_BOOST_ASIO@ with ON or OFF during generation
set(IOTEYE_USE_BOOST_ASIO @IOTEYE_USE_BOOST_ASIO@)

if(IOTEYE_USE_BOOST_ASIO)
    find_dependency(Boost)
else()
    find_dependency(asio)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ioteyeserverTargets.cmake")
check_required_components(ioteyeserver)